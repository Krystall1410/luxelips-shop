# ========================================================
# RENDER PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy các giá trị này vào mục Environment trên Render.com
# ========================================================

APP_NAME=LuxeLips
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE-NAME.onrender.com
APP_KEY=base64:THAY_BANG_APP_KEY_TRONG_FILE_ENV_LOCAL_CUA_BAN
TRUSTED_PROXIES=*

# Cấu hình kết nối MySQL Aiven (Thay bằng thông số từ trang Aiven Overview)
DB_CONNECTION=mysql
DB_HOST=YOUR-AIVEN-HOST.aivencloud.com
DB_PORT=YOUR-AIVEN-PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=YOUR-AIVEN-PASSWORD
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

# Cấu hình Session & Cache
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Cấu hình Port & Tự động chạy Migration trên Render
PORT=10000
RUN_MIGRATIONS=true
RUN_SEEDERS=false

# ========================================================
# CẤU HÌNH GỬI EMAIL TRÊN RENDER (GỬI THẬT QUA BREVO HTTP API)
# Render Free chặn cổng SMTP 587/465 nên dùng Brevo qua cổng 443 HTTPS (Miễn phí 300 mail/ngày)
# Đăng ký lấy API Key tại https://app.brevo.com/settings/keys/api
# ========================================================
MAIL_MAILER=brevo
BREVO_API_KEY=THAY_BANG_BREVO_API_KEY_CUA_BAN
MAIL_FROM_ADDRESS=sonnas14102005@gmail.com
MAIL_FROM_NAME="LuxeLips"

# Cấu hình Giao Hàng Nhanh (GHN)
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
